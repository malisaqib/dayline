{
  "name": "dayline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/migrate.ts",
    "check:feeds": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/check-feeds.ts",
    "check:db": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/check-supabase.ts",
    "check:ai": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/check-ai.ts",
    "test": "tsx --tsconfig tsconfig.json --test tests/*.test.ts",
    "check:flow": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/check-flow.ts",
    "check:journey": "tsx --tsconfig tsconfig.json scripts/check-journey.ts",
    "check:daily": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/check-daily.ts",
    "check:scheduled": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/check-scheduled.ts",
    "cron:setup": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/setup-cron.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "fast-xml-parser": "^5.11.2",
    "motion": "^14.3.0",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
