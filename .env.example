# Copy to .env.local and fill in values. Never commit .env.local.
# All variables are server-only (no NEXT_PUBLIC_ prefix).

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Connect > Session pooler connection string (used only by `npm run db:migrate`)
SUPABASE_DB_URL=

# Anthropic Console > API keys
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5
ANTHROPIC_MODEL=
