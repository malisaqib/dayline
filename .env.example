# Copy to .env.local and fill in values. Never commit .env.local.

# --- Public (safe in the browser; data is protected by RLS) ---
# Supabase > Project Settings > API: Project URL and the publishable key (sb_publishable_... or legacy anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secret (server only; never add NEXT_PUBLIC_) ---
# Supabase > Project Settings > API Keys: secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
# Supabase > Connect > Session pooler connection string (used only by `npm run db:migrate`)
SUPABASE_DB_URL=
# Anthropic Console > API keys
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5. Set explicitly to choose a cheaper model.
ANTHROPIC_MODEL=
